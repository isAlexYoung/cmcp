{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/isAlexYoung/cmcp/cmcp-tool.schema.json",
  "title": "CMCP local MCP tool (cmcp-tools/1)",
  "type": "object",
  "required": [
    "schema",
    "name",
    "description",
    "transport",
    "capabilities"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "maxLength": 64
    },
    "license": {
      "type": "string",
      "maxLength": 64
    },
    "homepage": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 512
    },
    "transport": {
      "enum": [
        "stdio",
        "http",
        "sse"
      ]
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "args": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "cwd": {
      "type": "string",
      "maxLength": 1024
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 8192
          },
          {
            "type": "object",
            "properties": {
              "secret": {
                "const": true
              },
              "label": {
                "type": "string",
                "maxLength": 100
              },
              "template": {
                "type": "string",
                "maxLength": 512,
                "pattern": "\\{value\\}"
              }
            },
            "required": [
              "secret"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "url": {
      "type": "string",
      "description": "http(s) on 127.0.0.1, localhost or [::1]; a remote server must use https.",
      "pattern": "^(https?://(127\\.0\\.0\\.1|localhost|\\[::1\\])(:[0-9]+)?(/|$)|https://)"
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 8192
          },
          {
            "type": "object",
            "properties": {
              "secret": {
                "const": true
              },
              "label": {
                "type": "string",
                "maxLength": 100
              },
              "template": {
                "type": "string",
                "maxLength": 512,
                "pattern": "\\{value\\}"
              }
            },
            "required": [
              "secret"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "start": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "args": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        }
      },
      "additionalProperties": false
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "win32",
          "darwin"
        ]
      }
    },
    "requires": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "runtime"
        ],
        "properties": {
          "runtime": {
            "type": "string",
            "maxLength": 32
          },
          "min": {
            "type": "string",
            "maxLength": 32
          },
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "hint": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "files",
          "exec",
          "python",
          "network",
          "gui",
          "hardware",
          "credentials"
        ]
      }
    },
    "instructions": {
      "type": "string",
      "maxLength": 300
    },
    "lifecycle": {
      "enum": [
        "on-demand",
        "persistent"
      ]
    },
    "timeouts": {
      "type": "object",
      "properties": {
        "startMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "callMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        }
      },
      "additionalProperties": false
    },
    "maxConcurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "tools": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "descriptions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 1024
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "description": "Browser sign-in (OAuth) for an http or sse server.",
      "properties": {
        "type": {
          "const": "oauth"
        },
        "scope": {
          "type": "string",
          "maxLength": 512
        },
        "clientId": {
          "type": "string",
          "maxLength": 256
        },
        "callbackPort": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "preset": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "transport": {
            "const": "stdio"
          }
        }
      },
      "then": {
        "required": [
          "command"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "transport": {
            "enum": [
              "http",
              "sse"
            ]
          }
        }
      },
      "then": {
        "required": [
          "url"
        ]
      }
    }
  ]
}
